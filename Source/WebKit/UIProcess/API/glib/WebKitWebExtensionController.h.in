@API_SINGLE_HEADER_CHECK@

#ifndef WebKitWebExtensionController_h
#define WebKitWebExtensionController_h

#if ENABLE(2022_GLIB_API) && PLATFORM(GTK)

#include <@API_INCLUDE_PREFIX@/WebKitDefines.h>
#include <@API_INCLUDE_PREFIX@/WebKitNetworkSession.h>
#include <@API_INCLUDE_PREFIX@/WebKitWebExtensionContext.h>

G_BEGIN_DECLS

#define WEBKIT_TYPE_WEB_EXTENSION_CONTROLLER (webkit_web_extension_controller_get_type())

WEBKIT_DECLARE_FINAL_TYPE (WebKitWebExtensionController, webkit_web_extension_controller, WEBKIT, WEB_EXTENSION_CONTROLLER, GObject)

WEBKIT_API WebKitWebExtensionController *
webkit_web_extension_controller_new                     (WebKitNetworkSession           *session);

WEBKIT_API gboolean
webkit_web_extension_controller_load                    (WebKitWebExtensionController  *controller,
                                                         WebKitWebExtensionContext     *context,
                                                         GError                       **error);

WEBKIT_API gboolean
webkit_web_extension_controller_unload                  (WebKitWebExtensionController  *controller,
                                                         WebKitWebExtensionContext     *context,
                                                         GError                       **error);

G_END_DECLS

#endif

#endif
