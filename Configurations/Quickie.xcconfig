// Build settings of the Quickie fork (github.com/izevg/WebKit, branches quickie/*).
// CommonBase.xcconfig includes this file, so every project of the Cocoa build sees
// QUICKIE_GCC_PREPROCESSOR_DEFINITIONS.

// ENABLE(WEB_AUTHN_OWN_MANAGER): Web Authentication requests from web pages go to WebKit's own
// AuthenticatorManager (USB/HID and CCID security keys, the Secure Enclave local authenticator)
// and the embedder's _WKWebAuthenticationPanel UI, never to AuthenticationServices. Quickie is
// distributed with Developer ID and does not hold Apple's web-browser public-key-credential
// entitlement, without which AuthenticationServices refuses arbitrary relying parties.
QUICKIE_GCC_PREPROCESSOR_DEFINITIONS[sdk=macosx*] = ENABLE_WEB_AUTHN_OWN_MANAGER=1;
